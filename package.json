{
  "name": "reviewrankr-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ReviewRankr \u2014 AI review & reputation platform API",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/jobs/worker.js",
    "seed": "node scripts/seed.js",
    "test": "node --test test/unit.test.js",
    "setup": "npm --prefix .. run setup",
    "dev:all": "npm --prefix .. run dev",
    "make-admin": "node scripts/make-admin.js",
    "create-admin": "node scripts/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "node-cron": "^3.0.3",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "mongodb-memory-server-core": "^10.1.2"
  }
}
