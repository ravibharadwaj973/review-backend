# ─── Required ────────────────────────────────────────────────────────────────
# MongoDB connection (MongoDB Atlas or local). Leave empty in development to use
# an embedded MongoDB that stores data in backend/.data (downloaded on first run).
MONGODB_URI=

# Groq API key for AI analysis and replies (https://console.groq.com/keys).
# GROQ_URI is also accepted. Without a key, a built-in fallback writer is used.
GROQ_API_KEY=

# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=

# ─── Connect to the website ──────────────────────────────────────────────────
# The website address (no trailing slash). This one setting is used for review
# links, QR codes, Google sign-in and which website may call this API (CORS).
#   Local:      FRONTEND_URL=http://localhost:3000
#   Production: FRONTEND_URL=https://your-app.vercel.app
# Several are allowed, comma separated; the first one is used in links.
# Add https://*.vercel.app to also allow Vercel preview deployments.
FRONTEND_URL=http://localhost:3000
PORT=4000

# ─── Google Business Profile (optional until Google approves API access) ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${FRONTEND_URL}/api/google/oauth/callback — add this exact URL in Google Cloud.
GOOGLE_REDIRECT_URI=
# Public https base URL Google can fetch photos from (defaults to FRONTEND_URL).
PUBLIC_ASSET_URL=

# ─── Optional tuning ─────────────────────────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
# How often to check Google for new reviews (cron syntax)
REVIEW_SYNC_CRON=*/15 * * * *
# How often autopilot runs: auto replies, weekly photos and posts, seasonal hours
AUTOPILOT_CRON=*/5 * * * *
# Set to false when running the separate worker process (docker compose does this)
RUN_WORKER=true
# Proxies in front of the API: 1 = nginx only, 2 = Vercel + nginx (AWS + Vercel setup)
TRUST_PROXY=1
JWT_EXPIRES_IN=7d
