# ─── Required ────────────────────────────────────────────────────────────────
# MongoDB connection (MongoDB Atlas or local). Leave empty in development to use
# an embedded MongoDB that stores data in backend/.data (downloaded on first run).
MONGODB_URI=

# Groq API key for AI analysis and replies (https://console.groq.com/keys).
# GROQ_URI is also accepted. Without a key, a built-in fallback writer is used.
GROQ_API_KEY=

# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=

# ─── URLs ────────────────────────────────────────────────────────────────────
PORT=4000
# Where the web app is served. Used for review links, OAuth redirect and CORS.
APP_URL=http://localhost:3000

# ─── Google Business Profile (optional until Google approves API access) ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${APP_URL}/api/google/oauth/callback — add this exact URL in Google Cloud.
GOOGLE_REDIRECT_URI=
# Public https base URL Google can fetch photos from (defaults to APP_URL).
PUBLIC_ASSET_URL=

# ─── Optional tuning ─────────────────────────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
# How often to check Google for new reviews (cron syntax)
REVIEW_SYNC_CRON=*/15 * * * *
# Set to false when running the separate worker process (docker compose does this)
RUN_WORKER=true
JWT_EXPIRES_IN=7d
